{
  "$schema": "http://json-schema.org/schema",
  "$id": "NgxFormbarSchema",
  "title": "Generate Schema",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "description": "The name of the project.",
      "$default": { "$source": "projectName" }
    },
    "schematicsConfig": {
      "type": "string",
      "description": "The schematics configuration file to use"
    },
    "type": {
      "type": "string",
      "description": "The content union, as 'app/types/content.type.ts#AppContent'."
    },
    "emitter": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Run only the configured emitter entries whose 'use' matches one of these values."
    },
    "output": {
      "type": "string",
      "description": "Override the output path of a single configured emitter entry."
    }
  }
}
