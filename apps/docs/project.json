{
  "name": "@ngx-formbar/docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "docs",
  "sourceRoot": "apps/docs/src",
  "tags": [],
  "generators": {
    "@schematics/angular:component": {
      "changeDetection": "OnPush"
    }
  },
  "targets": {
    "build": {
      "executor": "@ng-doc/builder:vite-application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "configFile": "apps/docs/vite.config.mts",
        "outputPath": "dist/apps/docs"
      },
      "configurations": {
        "production": {
          "mode": "production"
        },
        "development": {
          "mode": "development"
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@ng-doc/builder:vite-dev-server",
      "continuous": true,
      "options": {
        "configFile": "apps/docs/vite.config.mts"
      },
      "configurations": {
        "production": {
          "mode": "production"
        },
        "development": {
          "mode": "development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "dependsOn": ["build"]
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "@ngx-formbar/docs:build",
        "port": 4200,
        "staticFilePath": "dist/apps/docs/browser",
        "spa": true
      },
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"]
    }
  }
}
