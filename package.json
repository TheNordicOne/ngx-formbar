    "@angular/language-service": "~22.2.0",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "24.0.4",
    "@nx/devkit": "24.0.4",
    "@nx/esbuild": "24.0.4",
    "@nx/eslint": "24.0.4",
